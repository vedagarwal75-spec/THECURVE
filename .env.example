# Copy this file to ".env" and fill in your own keys.
# The .env file is git-ignored so your secrets are never committed.

# Flask session secret (any long random string)
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini API key — powers the AI Tutor.  Free tier is fine.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: override the Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# GNews API key — powers the News Terminal.  Free tier is fine.
# Get one at: https://gnews.io/  (If missing, the app serves sample headlines.)
GNEWS_API_KEY=your-gnews-key-here

# Optional: set to 1 to enable Flask debug mode locally (keep 0 for demos)
# FLASK_DEBUG=0
